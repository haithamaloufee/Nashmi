MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
JWT_SECRET=replace_with_at_least_32_random_characters
RATE_LIMIT_SECRET=replace_with_a_different_32_character_random_secret
OPENAI_API_KEY=
YOUTUBE_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
RESEND_API_KEY=
EMAIL_FROM=Nashmi <no-reply@auth.nashmi.haitham.website>
# Preview/development safety: comma-separated recipients that may receive real messages.
EMAIL_ALLOWED_RECIPIENTS=
# Set only when a monitored inbox exists.
EMAIL_REPLY_TO=
MAX_UPLOAD_SIZE_MB=3
MAX_IMAGE_UPLOAD_SIZE_MB=5
MAX_VIDEO_UPLOAD_SIZE_MB=100
MAX_DOCUMENT_UPLOAD_SIZE_MB=20
STORAGE_PROVIDER=cloudflare_r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nashmi-media
R2_ENDPOINT=
# Leave empty while the bucket is private. Public media is delivered through /api/media/:id redirects.
R2_PUBLIC_BASE_URL=
R2_UPLOAD_EXPIRY_SECONDS=300
R2_DOWNLOAD_EXPIRY_SECONDS=300
R2_ENV_PREFIX=production
R2_USER_MEDIA_QUOTA_MB=1024
R2_PUBLISHER_MEDIA_QUOTA_MB=5120
R2_DAILY_UPLOAD_QUOTA_MB=512
# Transitional rollback only; remove after verified R2 migration and observation window.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODERATION_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite
# Set to true to enable official web grounding where supported by Gemini SDK.
GEMINI_ENABLE_GOOGLE_SEARCH=false
GEMINI_MAX_HISTORY_MESSAGES=30
GEMINI_MAX_LAW_CONTEXT_RESULTS=6
GEMINI_TEMPERATURE=0.3
# Live-news discovery is dry-run by default. Enable only after inspecting multiple safe runs.
NEWS_AUTO_PUBLISH=true
NEWS_REFRESH_SECRET=replace_with_a_different_32_character_random_secret
NEWS_GEMINI_MODEL=gemini-3.5-flash-lite
NEWS_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
NEWS_MAX_NEW_ITEMS=10
NEWS_RETENTION_DAYS=7
